##########################################################
# individual docker configuration for docker-compose.yml
##########################################################

COMPOSE_PROJECT_NAME=elwisexamparser
DOCKER_PROJECT_NAME=elwisexamparser

# default host-user under Manjaro Linux
DOCKER_UID=1000
DOCKER_GID=1000

# Python
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
